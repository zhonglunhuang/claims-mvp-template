                  "const body = pm.response.json(); const claim = (body && body.claim) || body;",
                  "pm.test('狀態是 draft', () => pm.expect(claim.status).to.eql('draft'));",
                  "pm.test('合計 1660', () => pm.expect(claim.total_amount).to.eql(1660));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_chen}}",
                "type": "text"
